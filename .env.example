# Red Kite hub — the settings your hub needs.
#
#     cp .env.example .env
#     nano .env
#
# **Never commit the real .env anywhere.** It holds your database password and, once you add a
# channel, your alerting credentials.
#
# Only the first four settings are required. Everything below them is optional, and the hub says
# plainly on its own health screen when it cannot send an alert rather than failing quietly.


# ================================================================================================
# REQUIRED — the hub will refuse to start without these four
# ================================================================================================

# The name this hub answers to. It must already resolve to this server before the first start:
#
#     dig +short hub.example.com
#
# Caddy asks Let's Encrypt for the certificate the moment it boots and the challenge fails if the
# record is not there yet. That failure reads like a broken deployment rather than a missing DNS
# record, so check it first, always.
HUB_HOSTNAME=hub.example.com

# Your sign-in account. On first start the hub creates this account and prints a sign-in token
# once — see the README. Use a real address you can receive alerts at.
ADMIN_EMAIL=you@example.com

# Your own organisation, which is the first customer on the hub and what you will see at the top
# of the screens. If you are watching only your own machines, your business name is the right
# answer; if you look after other people's, this is you rather than them.
#
# Read once, on the very first start, into an empty database. Changing it afterwards does nothing —
# rename the customer on the screens instead.
ORGANISATION_NAME=My organisation

# Where Let's Encrypt sends certificate expiry and problem notices. A mailbox somebody actually
# reads, not a no-reply. Treat a message from them as an emergency rather than as marketing.
ACME_EMAIL=you@example.com

# The database password. Generate it, do not invent it, and do not reuse one from anywhere else —
# this database holds your machine list and your hashed agent tokens:
#
#     openssl rand -base64 32
#
# Changing this after the first start changes only the connection string, not the database.
# Postgres initialises itself exactly once, on an empty volume, and never again.
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32


# ================================================================================================
# STRONGLY RECOMMENDED — who watches the watcher
# ================================================================================================
# The hub pings this URL on a timer. If the hub dies, the outside service notices the silence and
# tells you.
#
# **A monitor cannot report its own absence.** That is the exact gap Red Kite exists to close, and
# it is the one gap the hub cannot close for itself. Healthchecks.io's free tier is enough, takes
# two minutes, and is the difference between a hub that fails loudly and one that fails silently.
HEALTHCHECKS_PING_URL=


# ================================================================================================
# OPTIONAL — which version to run
# ================================================================================================
# Blank means :latest, which is fine while you are trying it. Once the hub is watching anything you
# care about, pin a version here so an update is something you choose rather than something that
# arrives:
#
#     REDKITE_VERSION=0.4.0
REDKITE_VERSION=


# ================================================================================================
# OPTIONAL — alert email
# ================================================================================================
# Which way email leaves: "smtp" or "postmark". Set it explicitly. With both configured and
# neither chosen the hub refuses to guess and says so on its health screen rather than quietly
# sending by a route nobody picked.
#
# **Prefer a transactional provider or a dedicated sending relay over a mailbox relay** like
# Microsoft 365 or Gmail. A mail path shared with everything else you do has its own silent
# failure modes, and an alert in a spam folder is indistinguishable from no alert at all. Whatever
# you choose, set SPF, DKIM and DMARC on the sending domain — that is the part that decides
# whether the message actually arrives, and it is yours to get right either way.
EMAIL_PROVIDER=
ALERT_FROM_ADDRESS=

# ---- if EMAIL_PROVIDER=postmark ----
# An API returns a message id you can ask about afterwards, which is why it is the better choice.
EMAIL_API_KEY=

# ---- if EMAIL_PROVIDER=smtp ----
# 587 is submission with STARTTLS and the right default. 2525 is the usual alternative where an
# ISP blocks 587; 465 is implicit TLS and is detected from the port.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=


# ================================================================================================
# OPTIONAL — alert SMS (Twilio)
# ================================================================================================
# Pennies per message, and unaffected by your domain's reputation — which is exactly why alerts go
# by every channel a person has chosen rather than by email alone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# ================================================================================================
# OPTIONAL — alert push (Pushover)
# ================================================================================================
# This token identifies Red Kite to Pushover. Each person's own user key is held against their
# account in the hub, not here.
PUSHOVER_APPLICATION_TOKEN=


# ================================================================================================
# OPTIONAL — the database name and user
# ================================================================================================
# Defaults are redkite and redkite. There is rarely a reason to change them.
POSTGRES_DB=redkite
POSTGRES_USER=redkite
